# PostgreSQL (source of truth)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/backlinks
DB_MAX_CONNECTIONS=60        # TOTAL budget of every app process together (API + engine + Celery workers + 1 per engine); keep below PostgreSQL max_connections minus reserved/other clients
DB_APP_PROCESSES=6           # processes sharing that budget; each process's pool max = DB_MAX_CONNECTIONS // DB_APP_PROCESSES (at least 6) unless DB_POOL_MAX is set
# DB_POOL_MAX=10             # per-process pool maximum (overrides the share); DB_POOL_MIN=1 connections kept open; DB_POOL_MAX_IDLE=300 and DB_POOL_MAX_LIFETIME=1800 seconds
DB_POOL_WAIT=30              # a caller waits this long for a free pooled connection, then fails loudly (TimeoutError)
API_DB_WAIT=5                # an API request waits this long for a pooled connection, then answers HTTP 503 + Retry-After (workers/engine keep DB_POOL_WAIT)

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=1                 # autonomous.py then dispatches to Celery workers instead of crawling itself
CELERY_WORKER_CONCURRENCY=1  # Windows (solo pool): keep 1 and start several workers. Linux prefork: e.g. 4
CELERY_TASK_TIME_LIMIT=900   # seconds; also the lease length of a claimed batch
CELERY_MAX_RETRIES=5         # task-level retries for temporary database errors (exponential backoff + jitter)
CELERY_RETRY_BACKOFF_MAX=300
CELERY_MAX_QUEUED=4          # crawl tasks allowed to wait in Redis
CRAWL_CONCURRENCY=25         # concurrent HTTP fetches inside ONE task
CRAWL_CLAIM_BATCH=500        # URLs one task leases; 50 makes Ctrl+C (warm shutdown) finish in about a minute instead of several

# In-memory read cache of the API (per process, no Redis, OFF unless enabled): backlink summary, referring-domain and anchor pages.
# Totals may be up to GRAPH_CACHE_TTL_SECONDS behind the latest crawl write; live job/discovery status is never cached. Each API process has its own cache.
GRAPH_CACHE_ENABLED=false
GRAPH_CACHE_TTL_SECONDS=15       # freshness; never above GRAPH_CACHE_MAX_TTL_SECONDS
GRAPH_CACHE_MAX_TTL_SECONDS=30
GRAPH_CACHE_MAX_ENTRIES=1000
# GRAPH_CACHE_MAX_MB=32          # estimated memory bound (default 32); least recently used entries go first
# GRAPH_CACHE_MAX_STALE_SECONDS=120   # a failed refresh may serve the old entry only while it is younger than TTL + this, for GRAPH_CACHE_RETRY_SECONDS (5) at a time

# Crawler identity
CRAWLER_CONTACT_URL=https://example.com/bot

# Tests only (never in production): isolated schema, allow 127.0.0.1 targets
# DB_SCHEMA=
# CRAWLER_ALLOW_PRIVATE=1

# Business onboarding scheduler (all optional; these are the defaults)
MAX_CRAWL_WORKERS=4
BUSINESS_RESERVED_WORKERS=3
MAX_ACTIVE_TASKS_PER_BUSINESS=1
MAX_PAGES_PER_BUSINESS_RUN=150
MAX_DEPTH=3
FOLLOW_EXTERNAL_DOMAINS=false
DDGS_ENABLED=true
DDGS_RESULTS_PER_RUN=50
DDGS_MAX_RESULTS=60
DDGS_INTERVAL_HOURS=6
DDGS_SEARCH_CONCURRENCY=1
DDGS_MAX_RETRIES=3
DDGS_BACKENDS=duckduckgo,brave,bing,yahoo   # first usable serves a query; a fallback backend starts at its own page 1
DDGS_MAX_PAGES_PER_QUERY=5
DDGS_DUP_PAGES_LIMIT=3
DDGS_EMPTY_CONFIRM_RUNS=2
DDGS_REDISCOVERY_DAYS=3
# serper.dev (Google results, paid credits): when set it becomes the first search backend
SERPER_API_KEY=
SERPER_DAILY_LIMIT=1000
# SERPER_QUOTES=1  (paid plan only: send the quoted exact-match query; free accounts refuse quotes)
MAX_OUTSTANDING_URLS_PER_TARGET=300
DDGS_FAIR_POLICY=hierarchical   # or target
DDGS_COMPETITOR_MAX_WAIT_SECONDS=1800
DDG_COOLDOWN_SECONDS=60
AUTONOMOUS_SOURCES=          # empty = business-driven only; tranco,feeds re-enables generic discovery

# Competitor discovery (targets monitored like businesses, results compared by /businesses/{domain}/backlink-gap)
COMPETITOR_DISCOVERY_ENABLED=true
COMPETITOR_DDGS_INTERVAL_HOURS=3
COMPETITOR_DDGS_RESULTS=50
MAX_ACTIVE_COMPETITOR_JOBS=2   # competitor jobs searching/crawling at once; searches stay one at a time (DDGS_SEARCH_CONCURRENCY), so this lets competitor crawls overlap. Keep <= MAX_CRAWL_WORKERS - 2
