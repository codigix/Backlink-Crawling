# PostgreSQL (source of truth)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/backlinks
DB_MAX_CONNECTIONS=20        # per process; callers over the cap wait DB_POOL_WAIT seconds, then fail loudly
DB_POOL_WAIT=30

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=1                 # autonomous.py then dispatches to Celery workers instead of crawling itself
CELERY_WORKER_CONCURRENCY=1  # Windows (solo pool): keep 1 and start several workers. Linux prefork: e.g. 4
CELERY_TASK_TIME_LIMIT=900   # seconds; also the lease length of a claimed batch
CELERY_MAX_RETRIES=5         # task-level retries for temporary database errors (exponential backoff + jitter)
CELERY_RETRY_BACKOFF_MAX=300
CELERY_MAX_QUEUED=4          # crawl tasks allowed to wait in Redis
CRAWL_CONCURRENCY=25         # concurrent HTTP fetches inside ONE task
CRAWL_CLAIM_BATCH=500        # URLs one task leases; 50 makes Ctrl+C (warm shutdown) finish in about a minute instead of several

# Crawler identity
CRAWLER_CONTACT_URL=https://example.com/bot

# Tests only (never in production): isolated schema, allow 127.0.0.1 targets
# DB_SCHEMA=
# CRAWLER_ALLOW_PRIVATE=1

# Business onboarding scheduler (all optional; these are the defaults)
MAX_CRAWL_WORKERS=4
BUSINESS_RESERVED_WORKERS=3
MAX_ACTIVE_TASKS_PER_BUSINESS=1
MAX_PAGES_PER_BUSINESS_RUN=150
MAX_DEPTH=3
FOLLOW_EXTERNAL_DOMAINS=false
DDGS_ENABLED=true
DDGS_RESULTS_PER_RUN=50
DDGS_MAX_RESULTS=60
DDGS_INTERVAL_HOURS=6
DDGS_SEARCH_CONCURRENCY=1
DDGS_MAX_RETRIES=3
DDGS_BACKENDS=duckduckgo,brave,bing,yahoo   # first usable serves a query; a fallback backend starts at its own page 1
DDGS_MAX_PAGES_PER_QUERY=5
DDGS_DUP_PAGES_LIMIT=3
DDGS_EMPTY_CONFIRM_RUNS=2
DDGS_REDISCOVERY_DAYS=3
MAX_OUTSTANDING_URLS_PER_TARGET=300
DDGS_FAIR_POLICY=hierarchical   # or target
DDGS_COMPETITOR_MAX_WAIT_SECONDS=1800
DDG_COOLDOWN_SECONDS=60
AUTONOMOUS_SOURCES=          # empty = business-driven only; tranco,feeds re-enables generic discovery

# Competitor discovery (targets monitored like businesses, results compared by /businesses/{domain}/backlink-gap)
COMPETITOR_DISCOVERY_ENABLED=true
COMPETITOR_DDGS_INTERVAL_HOURS=24
COMPETITOR_DDGS_RESULTS=50
MAX_ACTIVE_COMPETITOR_JOBS=1   # competitor jobs searching/crawling at once; customer-business jobs are never held back by this
