# PostgreSQL (source of truth)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/backlinks
DB_MAX_CONNECTIONS=20        # per process; callers over the cap wait DB_POOL_WAIT seconds, then fail loudly
DB_POOL_WAIT=30

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
USE_CELERY=1                 # autonomous.py then dispatches to Celery workers instead of crawling itself
CELERY_WORKER_CONCURRENCY=1  # Windows (solo pool): keep 1 and start several workers. Linux prefork: e.g. 4
CELERY_TASK_TIME_LIMIT=900   # seconds; also the lease length of a claimed batch
CELERY_MAX_RETRIES=5         # task-level retries for temporary database errors (exponential backoff + jitter)
CELERY_RETRY_BACKOFF_MAX=300
CELERY_MAX_QUEUED=4          # crawl tasks allowed to wait in Redis
CRAWL_CONCURRENCY=25         # concurrent HTTP fetches inside ONE task

# Crawler identity
CRAWLER_CONTACT_URL=https://example.com/bot

# Tests only (never in production): isolated schema, allow 127.0.0.1 targets
# DB_SCHEMA=
# CRAWLER_ALLOW_PRIVATE=1
